# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# AWS Configuration
# ============================================
# Do NOT put AWS access keys here.
# Use AWS CLI profiles locally, or IAM roles on EC2.
AWS_REGION=ap-south-1

# ============================================
# Amazon S3
# ============================================
S3_BUCKET_NAME=disaster-response-images-mural-2026

# ============================================
# Amazon DynamoDB
# ============================================
DYNAMODB_TABLE_NAME=DisasterReports
DYNAMODB_USERS_TABLE_NAME=DisasterUsers

# ============================================
# Amazon Cognito (normal user authentication)
# ============================================
# Admin authentication below is separate and does NOT use Cognito.
# Client ID = the Cognito SPA app client (no client secret).
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-cognito-app-client-id

# ============================================
# Amazon SNS
# ============================================
SNS_TOPIC_ARN=

# ============================================
# Groq AI
# ============================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ============================================
# Admin Authentication
# ============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=

# ============================================
# Frontend URL (for CORS)
# ============================================
FRONTEND_URL=http://localhost:5173
